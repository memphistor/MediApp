{
  "name": "mediapp-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --lan",
    "start:go": "expo start --lan",
    "start:dev-client": "expo start --dev-client --lan",
    "start:tunnel": "expo start --tunnel",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "eas:preview:ios": "eas build --profile preview --platform ios",
    "update:preview": "eas update --channel preview --environment preview",
    "eas:preview:android": "eas build --profile preview --platform android",
    "eas:production": "eas build --profile production --platform all",
    "eas:submit:ios": "eas submit --profile production --platform ios",
    "eas:submit:android": "eas submit --profile production --platform android"
  },
  "dependencies": {
    "@mediapp/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-picker/picker": "2.11.4",
    "expo": "~58.0.23",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.18",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-linking": "~58.0.16",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-splash-screen": "~58.0.13",
    "expo-sqlite": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-symbols": "~58.0.4",
    "expo-updates": "~58.0.21",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "private": true
}
